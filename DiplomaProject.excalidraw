      "version": 1241,
      "versionNonce": 1905680204,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792514818528,
      "link": null,
      "locked": false,
      "created": 1791988345317,
      "text": "Споживання\n* 4х Жовті Мотори-редуктори\n— до 4.8 Ампер\n* 2х Драйвер DC двигунів \n(керування кожним колесом окремо)\n\nЖивлення\n* Понижуючий перетв. напруги\nXL4016 TC43200 на 10А",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "labelPosition": 0,
