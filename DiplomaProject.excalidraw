      ],
      "updated": 1791911796076,
      "link": null,
      "locked": false,
      "created": 1791900986457,
      "text": "\nВ результаті до 20.8 Ампер\nМаксимальне споживання чисто на підвіску.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "labelPosition": 0,
      "originalText": "\nВ результаті до 20.8 Ампер\nМаксимальне споживання чисто на підвіску.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "WM5mPk4VvlTOa3xVEvSTf",
      "type": "text",
      "x": -646.8355744611363,
      "y": 1290.8544763045156,
      "width": 193.15980529785156,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aS",
      "roundness": null,
      "seed": 1793666356,
      "version": 217,
      "versionNonce": 206882828,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791904893372,
      "link": null,
      "locked": false,
      "created": 1791901215578,
      "text": "Перелік компонентів",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "labelPosition": 0,
      "originalText": "Перелік компонентів",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "u2UAAOtzGHQ4o9vnbtsjN",
      "type": "text",
      "x": -592.1668093599866,
      "y": 1334.2562598840009,
      "width": 395.73974609375,
      "height": 925,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aT",
      "roundness": null,
      "seed": 382693812,
      "version": 1432,
      "versionNonce": 424554100,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792514696015,
      "link": null,
      "locked": false,
      "created": 1791904903823,
      "text": "Лапки:\n- 8х Сервоприводів MG995 (13kg)\n- 4x Жовтих Мотор-редукторів\n- 2х Драйвер DC двигунів\n- 2х Фари\n\nТурель:\n- 2х Сервоприводів SG90 (9g)\n- ESP32-CAM — відео\n- Модуль Лазерного променю\n- Дисплей малий (спрайти мордочки)\n\nУправління:\n- STM32 плата — керування лапками\n- ESP32 плата — збір данних з датчиків\nта радіопередача в обидва боки.\n- Датчик температури/вологості\n- Датчик акселерометр\n- Антенка\n\nЕнергоспоживання\n- 4х Понижуючий перетв. напруги\nXL4016 TC43200 на 10А\n- 6х Акумулятори Li-ion 18650\n- Високострумовий батарейний \nвідсік холдер.\n- BMS плата 3S2P Li-ion\n- Індикатор заряду\n- Роз'єм живлення 5.5 2.1 \n- Блок живлення 5.5 2.1\n\n- Запобіжник автомобільний 25А\n- Вимикач автомобільний 12V 30А\n- Роз'єми підключення XT60\n\nПроводка\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "labelPosition": 0,
      "originalText": "Лапки:\n- 8х Сервоприводів MG995 (13kg)\n- 4x Жовтих Мотор-редукторів\n- 2х Драйвер DC двигунів\n- 2х Фари\n\nТурель:\n- 2х Сервоприводів SG90 (9g)\n- ESP32-CAM — відео\n- Модуль Лазерного променю\n- Дисплей малий (спрайти мордочки)\n\nУправління:\n- STM32 плата — керування лапками\n- ESP32 плата — збір данних з датчиків\nта радіопередача в обидва боки.\n- Датчик температури/вологості\n- Датчик акселерометр\n- Антенка\n\nЕнергоспоживання\n- 4х Понижуючий перетв. напруги\nXL4016 TC43200 на 10А\n- 6х Акумулятори Li-ion 18650\n- Високострумовий батарейний \nвідсік холдер.\n- BMS плата 3S2P Li-ion\n- Індикатор заряду\n- Роз'єм живлення 5.5 2.1 \n- Блок живлення 5.5 2.1\n\n- Запобіжник автомобільний 25А\n- Вимикач автомобільний 12V 30А\n- Роз'єми підключення XT60\n\nПроводка\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "XmoKMfUEZRtaBB5x7ZUMO",
      "type": "text",
